{
  "name": "glifora",
  "version": "0.1.0",
  "private": true,
  "description": "Jogo web open source (PWA) para aprender idiomas conversando com NPCs.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/content/build-index.ts && vite",
    "build": "node scripts/content/build-index.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.node.json && tsc -p tests/e2e/tsconfig.json && tsc -p tests/e2e-security/tsconfig.json",
    "lint": "eslint .",
    "test": "node scripts/content/build-index.ts && vitest run",
    "test:watch": "node scripts/content/build-index.ts && vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
