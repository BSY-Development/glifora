      "expect": "accept",
      "raw": "{$HEAD,\"docs\":[{\"id\":\"__proto__\",\"v\":1,\"data\":{},\"updatedAt\":1,\"deleted\":0},{\"id\":\"constructor\",\"v\":1,\"data\":{},\"updatedAt\":1,\"deleted\":0},{\"id\":\"toString\",\"v\":1,\"data\":{},\"updatedAt\":1,\"deleted\":0}]}"
    },
    {
      "id": "unknown-doc-id",
