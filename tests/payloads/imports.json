      "raw": "{$HEAD,\"docs\":[{\"id\":\"avatar\",\"v\":2,\"data\":{\"__proto__\":{\"polluted\":\"v2\"}},\"updatedAt\":$NOW+1h,\"deleted\":0}]}"
    },
    {
