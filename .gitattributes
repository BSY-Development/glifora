# Quebra de linha LF no repositório e na cópia de trabalho (scripts shell, SQL e Deno não gostam de CRLF)
* text=auto eol=lf

# Scripts do Windows mantêm CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp3 binary
*.wav binary
*.ogg binary
*.m4a binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jks binary
*.gz binary
